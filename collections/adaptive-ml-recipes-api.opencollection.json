{
  "opencollection": "1.0.0",
  "info": {
    "name": "concorde artifacts::rest Recipes API",
    "version": "0.1.0"
  },
  "items": [
    {
      "info": {
        "name": "Recipes",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Download a recipe zip file from storage",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://your-adaptive-deployment/api/v1/api/v1/projects/:project/recipes/:recipe/download",
            "params": [
              {
                "name": "project",
                "value": "",
                "type": "path",
                "description": "Project ID or key"
              },
              {
                "name": "recipe",
                "value": "",
                "type": "path",
                "description": "Recipe ID or key"
              }
            ]
          },
          "docs": "Returns the recipe zip file as an attachment.\nSupports both project-specific recipes and global recipes (available in all projects)."
        }
      ]
    }
  ],
  "bundled": true
}